<Window x:Class="SmartDropZone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Drop Zone - Settings"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ==================== Toggle switch (Windows 11 style) ==================== -->
        <Style x:Key="ModernToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="11" Background="#33FFFFFF">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                            </Border>
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color"
                                                            To="#FF4CC2FF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color"
                                                            To="#33FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Segmented radio (dock edge pills) ==================== -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="18,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF4CC2FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Modern slider ==================== -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="#FF4CC2FF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Width="16" Height="16" Fill="White"
                                                             Stroke="#2EFFFFFF" StrokeThickness="1"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="#33FFFFFF"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Buttons ==================== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FF4CC2FF"/>
            <Setter Property="Foreground" Value="#FF0F141A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF6FD1FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33A9E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Background" Value="#0FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33E5484D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E9FFFFFF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- Floating rounded panel -->
    <Border CornerRadius="16" BorderBrush="#2EFFFFFF" BorderThickness="1" Margin="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F6282B33" Offset="0.0"/>
                <GradientStop Color="#F61F2329" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5" Color="#FF000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Margin="20,16,12,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="#FF4CC2FF" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                               Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        ToolTip="Close" Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="#1FFFFFFF" Margin="20,14,20,0"/>

            <!-- ===== Content ===== -->
            <StackPanel Grid.Row="2" Margin="20,16,20,18">

                <!-- Dock edge: segmented control -->
                <TextBlock Text="DOCK EDGE" Style="{StaticResource SectionLabel}"/>
                <Border CornerRadius="9" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                        BorderThickness="1" Padding="3" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="DockLeftRadio" Content="Left" GroupName="Dock"
                                    Style="{StaticResource SegmentRadio}"/>
                        <RadioButton x:Name="DockTopRadio" Content="Top" GroupName="Dock"
                                    Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                        <RadioButton x:Name="DockRightRadio" Content="Right" GroupName="Dock"
                                    Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                        <RadioButton x:Name="DockFreeRadio" Content="Free" GroupName="Dock"
                                    Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"
                                    ToolTip="Floating anywhere on screen; drag the header to move it"/>
                    </StackPanel>
                </Border>

                <!-- Behavior toggles -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Always on top" Style="{StaticResource SettingLabel}"/>
                    <ToggleButton x:Name="AlwaysOnTopCheck" Grid.Column="1"
                                  Style="{StaticResource ModernToggle}"/>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Always open (pinned)" Style="{StaticResource SettingLabel}"/>
                    <ToggleButton x:Name="AlwaysOpenCheck" Grid.Column="1"
                                  Style="{StaticResource ModernToggle}"/>
                </Grid>

                <!-- Collapse delay -->
                <TextBlock Text="COLLAPSE DELAY" Style="{StaticResource SectionLabel}" Margin="0,20,0,0"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="CollapseDelaySlider" Minimum="100" Maximum="2000"
                            TickFrequency="100" IsSnapToTickEnabled="True"
                            Style="{StaticResource ModernSlider}" Margin="0,0,14,0"/>
                    <Border Grid.Column="1" CornerRadius="8" Background="#1FFFFFFF" Padding="10,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="DelayLabel" Foreground="#E9FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- Start with Windows -->
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}"/>
                    <ToggleButton x:Name="StartWithWindowsCheck" Grid.Column="1"
                                  Style="{StaticResource ModernToggle}"/>
                </Grid>

                <!-- Animation speed -->
                <TextBlock Text="ANIMATION" Style="{StaticResource SectionLabel}" Margin="0,20,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Enable animations" Foreground="#E9FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="When off, the shelf snaps instantly" Foreground="#99FFFFFF" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="AnimateCheck" Grid.Column="1"
                                  Style="{StaticResource ModernToggle}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="AnimationSlider" Minimum="50" Maximum="400"
                            TickFrequency="10" IsSnapToTickEnabled="True"
                            Style="{StaticResource ModernSlider}" Margin="0,0,14,0"/>
                    <Border Grid.Column="1" CornerRadius="8" Background="#1FFFFFFF" Padding="10,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="AnimationLabel" Foreground="#E9FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- Floating-shelf behaviour -->
                <TextBlock Text="GESTURES" Style="{StaticResource SectionLabel}" Margin="0,20,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hold to detach" Foreground="#E9FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="Hold a docked shelf out of its edge to free it" Foreground="#99FFFFFF" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="HoldToDetachCheck" Grid.Column="1"
                                  Style="{StaticResource ModernToggle}" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hold to dock" Foreground="#E9FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="Hold a free shelf near a screen edge to snap it there" Foreground="#99FFFFFF" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="HoldToDockCheck" Grid.Column="1"
                                  Style="{StaticResource ModernToggle}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Hold delay / fill duration -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Hold delay" Foreground="#E9FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="Time to hold still before the ring starts filling" Foreground="#99FFFFFF" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="8" Background="#1FFFFFFF" Padding="10,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HoldDelayLabel" Foreground="#E9FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <Slider x:Name="HoldDelaySlider" Minimum="200" Maximum="3000"
                        TickFrequency="100" IsSnapToTickEnabled="True"
                        Style="{StaticResource ModernSlider}" Margin="0,4,0,0"/>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ring fill speed" Foreground="#E9FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="How long the ring takes to fill up" Foreground="#99FFFFFF" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="8" Background="#1FFFFFFF" Padding="10,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HoldFillLabel" Foreground="#E9FFFFFF" FontSize="11.5" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                <Slider x:Name="HoldFillSlider" Minimum="300" Maximum="5000"
                        TickFrequency="100" IsSnapToTickEnabled="True"
                        Style="{StaticResource ModernSlider}" Margin="0,4,0,0"/>

                <TextBlock Text="FLOATING SHELF" Style="{StaticResource SectionLabel}" Margin="0,20,0,0"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Expand on hover" Foreground="#E9FFFFFF" FontSize="12.5" VerticalAlignment="Center"/>
                        <TextBlock Text="When off, click the capsule to open it" Foreground="#99FFFFFF" FontSize="10" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ToggleButton x:Name="ExpandOnHoverCheck" Grid.Column="1"
                                  Style="{StaticResource ModernToggle}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Sort by -->
                <TextBlock Text="SORT BY" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"/>
                <Border CornerRadius="9" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                        BorderThickness="1" Padding="3" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="SortNameRadio" Content="Name" GroupName="Sort"
                                    Style="{StaticResource SegmentRadio}"/>
                        <RadioButton x:Name="SortTypeRadio" Content="Type" GroupName="Sort"
                                    Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                        <RadioButton x:Name="SortDateRadio" Content="Date" GroupName="Sort"
                                    Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- View mode -->
                <TextBlock Text="VIEW" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"/>
                <Border CornerRadius="9" Background="#14FFFFFF" BorderBrush="#1FFFFFFF"
                        BorderThickness="1" Padding="3" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ViewListRadio" Content="List" GroupName="View"
                                    Style="{StaticResource SegmentRadio}"/>
                        <RadioButton x:Name="ViewIconsRadio" Content="Icons" GroupName="View"
                                    Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Footer buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Content="Done" Width="92" Height="32"
                            Style="{StaticResource PrimaryButton}" Click="Done_Click"/>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>