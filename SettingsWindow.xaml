<Window x:Class="SmartDropZone.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Drop Zone - Settings"
        Width="440" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ==================== Toggle switch (Windows 11 style) ==================== -->
        <Style x:Key="ModernToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource HoverBrush}">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                            </Border>
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobShift"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Segmented radio (pills) ==================== -->
        <Style x:Key="SegmentRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Modern slider ==================== -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Width="16" Height="16" Fill="White"
                                                             Stroke="{DynamicResource CardHoverBrush}" StrokeThickness="1"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                                        Background="{DynamicResource HoverBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Buttons ==================== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FF0F141A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF6FD1FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF33A9E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33E5484D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ==================== Tabs ==================== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1"
                                      Background="Transparent"/>
                            <Border Grid.Row="1" Background="Transparent" Padding="0,8,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="0,6,0,0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="12,6" Margin="2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Floating rounded panel -->
    <Border CornerRadius="16" BorderBrush="{DynamicResource CardHoverBrush}" BorderThickness="1" Margin="14">
        <Border.Background>
            <SolidColorBrush Color="#F51F242E"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5" Color="#FF000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Margin="20,16,12,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                        Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                        ToolTip="Close" Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource InputBorderBrush}" Margin="20,14,20,0"/>

            <!-- ===== Content (tabs) ===== -->
            <TabControl Grid.Row="2" Margin="20,8,20,0">

                <!-- ========== GENERAL ========== -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="DOCK EDGE" Style="{StaticResource SectionLabel}"/>
                            <Border CornerRadius="9" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1" Padding="3" Margin="0,8,0,0">
                                <WrapPanel>
                                    <RadioButton x:Name="DockLeftRadio" Content="Left" GroupName="Dock"
                                                Style="{StaticResource SegmentRadio}"/>
                                    <RadioButton x:Name="DockTopRadio" Content="Top" GroupName="Dock"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                    <RadioButton x:Name="DockRightRadio" Content="Right" GroupName="Dock"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                    <RadioButton x:Name="DockFreeRadio" Content="Free" GroupName="Dock"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"
                                                ToolTip="Floating anywhere on screen; drag the header to move it"/>
                                </WrapPanel>
                            </Border>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Always on top" Style="{StaticResource SettingLabel}"/>
                                <ToggleButton x:Name="AlwaysOnTopCheck" Grid.Column="1"
                                              Style="{StaticResource ModernToggle}"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Always open (pinned)" Style="{StaticResource SettingLabel}"/>
                                <ToggleButton x:Name="AlwaysOpenCheck" Grid.Column="1"
                                              Style="{StaticResource ModernToggle}"/>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}"/>
                                <ToggleButton x:Name="StartWithWindowsCheck" Grid.Column="1"
                                              Style="{StaticResource ModernToggle}"/>
                            </Grid>

                            <TextBlock Text="COLLAPSE DELAY" Style="{StaticResource SectionLabel}" Margin="0,20,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="CollapseDelaySlider" Minimum="100" Maximum="2000"
                                        TickFrequency="100" IsSnapToTickEnabled="True"
                                        Style="{StaticResource ModernSlider}" Margin="0,0,14,0"/>
                                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource InputBorderBrush}" Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="DelayLabel" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== APPEARANCE ========== -->
                <TabItem Header="Appearance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="THEME" Style="{StaticResource SectionLabel}"/>
                            <Border CornerRadius="9" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1" Padding="3" Margin="0,8,0,0">
                                <WrapPanel>
                                    <RadioButton x:Name="ThemeSlateRadio" Content="Slate" GroupName="Theme"
                                                Style="{StaticResource SegmentRadio}"/>
                                    <RadioButton x:Name="ThemeOceanRadio" Content="Ocean" GroupName="Theme"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                    <RadioButton x:Name="ThemeForestRadio" Content="Forest" GroupName="Theme"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                    <RadioButton x:Name="ThemeEmberRadio" Content="Ember" GroupName="Theme"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                    <RadioButton x:Name="ThemeVioletRadio" Content="Violet" GroupName="Theme"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                    <RadioButton x:Name="ThemeLightRadio" Content="Light" GroupName="Theme"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                </WrapPanel>
                            </Border>

                            <TextBlock Text="TRANSPARENCY" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Style="{StaticResource ModernSlider}" Margin="0,0,14,0"/>
                                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource InputBorderBrush}" Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="OpacityLabel" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="ANIMATION" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Enable animations" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="When off, the shelf snaps instantly" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="AnimateCheck" Grid.Column="1"
                                              Style="{StaticResource ModernToggle}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="AnimationSlider" Minimum="50" Maximum="400"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        Style="{StaticResource ModernSlider}" Margin="0,0,14,0"/>
                                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource InputBorderBrush}" Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="AnimationLabel" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== BEHAVIOR ========== -->
                <TabItem Header="Behavior">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="FLOATING SHELF" Style="{StaticResource SectionLabel}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Expand on hover" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="When off, click the capsule to open it" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="ExpandOnHoverCheck" Grid.Column="1"
                                              Style="{StaticResource ModernToggle}" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock Text="HOLD GESTURES" Style="{StaticResource SectionLabel}" Margin="0,22,0,0"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hold to detach" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hold a docked shelf out of its edge to free it" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="HoldToDetachCheck" Grid.Column="1"
                                              Style="{StaticResource ModernToggle}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hold to dock" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="Hold a free shelf near a screen edge to snap it there" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="HoldToDockCheck" Grid.Column="1"
                                              Style="{StaticResource ModernToggle}" VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Hold delay" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="Time to hold still before the ring starts filling" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource InputBorderBrush}" Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="HoldDelayLabel" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Slider x:Name="HoldDelaySlider" Minimum="200" Maximum="3000"
                                    TickFrequency="100" IsSnapToTickEnabled="True"
                                    Style="{StaticResource ModernSlider}" Margin="0,4,0,0"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Ring fill speed" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="How long the ring takes to fill up" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource InputBorderBrush}" Padding="10,3"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="HoldFillLabel" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>
                            <Slider x:Name="HoldFillSlider" Minimum="300" Maximum="5000"
                                    TickFrequency="100" IsSnapToTickEnabled="True"
                                    Style="{StaticResource ModernSlider}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ========== SORT & VIEW ========== -->
                <TabItem Header="Sort &amp; View">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4,0,8">
                            <TextBlock Text="SORT BY" Style="{StaticResource SectionLabel}"/>
                            <Border CornerRadius="9" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1" Padding="3" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SortNameRadio" Content="Name" GroupName="Sort"
                                                Style="{StaticResource SegmentRadio}"/>
                                    <RadioButton x:Name="SortTypeRadio" Content="Type" GroupName="Sort"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                    <RadioButton x:Name="SortDateRadio" Content="Date" GroupName="Sort"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="VIEW" Style="{StaticResource SectionLabel}" Margin="0,18,0,0"/>
                            <Border CornerRadius="9" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                    BorderThickness="1" Padding="3" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ViewListRadio" Content="List" GroupName="View"
                                                Style="{StaticResource SegmentRadio}"/>
                                    <RadioButton x:Name="ViewIconsRadio" Content="Icons" GroupName="View"
                                                Style="{StaticResource SegmentRadio}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>

            <!-- ===== Footer ===== -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,14,20,16">
                <Button Content="Done" Width="92" Height="32"
                        Style="{StaticResource PrimaryButton}" Click="Done_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
