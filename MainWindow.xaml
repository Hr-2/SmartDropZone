<Window x:Class="SmartDropZone.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart Drop Zone"
        Width="334" Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SourceInitialized="Window_SourceInitialized"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseMove="Window_HeaderDrag_MouseMove"
        MouseLeftButtonUp="Window_HeaderDrag_MouseLeftButtonUp"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        DragOver="Window_DragOver"
        DragLeave="Window_DragLeave"
        Drop="Window_Drop">

    <Window.Resources>

        <!-- ==================== Resize grip ==================== -->
        <Style x:Key="EdgeThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Visible, easy-to-grab corner resize handle -->
        <Style x:Key="CornerResizeThumb" TargetType="Thumb">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="SizeNWSE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="#33222222" BorderBrush="{DynamicResource SubtleTextBrush}"
                                BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Path Data="M 13,19 L 19,13" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                <Path Data="M 9,19 L 19,9" Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1.5"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#554CC2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Card (list item) style ==================== -->
        <!-- Explorer-style list row: compact, rounded hover + selection highlight. -->
        <Style x:Key="CardItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="8,0">
                            <Border.Background>
                                <SolidColorBrush Color="Transparent"/>
                            </Border.Background>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Per-item remove button (fades in on card hover) ==================== -->
        <Style x:Key="RemoveButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <TextBlock Text="{TemplateBinding Content}"
                                       FontSize="11"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4DE5484D"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Show the button only while the containing card is hovered -->
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                    <Setter Property="IsHitTestVisible" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ==================== Items panels (list vs icon grid) ==================== -->
        <ItemsPanelTemplate x:Key="ListPanel">
            <StackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel/>
        </ItemsPanelTemplate>

        <!-- Explorer "Details"-style list view: inline icon + name + subtitle row -->
        <DataTemplate x:Key="ListCardTemplate">
            <Grid Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>

                <Image Source="{Binding Icon}" Width="20" Height="20" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,6,0">
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FullDescription}"/>
                    <TextBlock Text="{Binding Subtitle}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10.5" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button Grid.Column="2" Content="&#x2715;"
                        Style="{DynamicResource RemoveButtonStyle}"
                        ToolTip="Remove from shelf"
                        Click="RemoveItem_Click"/>
            </Grid>
        </DataTemplate>

        <!-- Explorer "Large icons" style: big icon, label gets a highlight on hover -->
        <DataTemplate x:Key="GridCardTemplate">
            <Grid Width="96" Height="100" ToolTip="{Binding FullDescription}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="Uniform"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>

                <Border Grid.Row="1" CornerRadius="4" Padding="4,2" Margin="2,0,2,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Name}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontSize="11" TextAlignment="Center" TextWrapping="Wrap"
                               MaxHeight="30" TextTrimming="CharacterEllipsis"/>
                </Border>

                <Button Content="&#x2715;"
                        Style="{DynamicResource RemoveButtonStyle}"
                        ToolTip="Remove from shelf"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Click="RemoveItem_Click"/>
            </Grid>
        </DataTemplate>

        <!-- Tile container for the icon grid view -->
        <Style x:Key="GridContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="104"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent" Padding="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource InputBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Ghost button (Clear All / options) ==================== -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardSeparatorBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Dark vertical scrollbar ==================== -->
        <Style x:Key="DarkScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{DynamicResource SubtleTextBrush}" CornerRadius="4" Margin="1,0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== Dark context menu ==================== -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#F51F242E"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#3AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#FF000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource CardHoverBrush}" Margin="8,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <!-- Item row -->
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CheckMark" Grid.Column="0"
                                               Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>
                                    <Path x:Name="Arrow" Grid.Column="2"
                                          Data="M 0,0 L 0,8 L 6,4 Z" Fill="{DynamicResource SecondaryTextBrush}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <!-- Submenu popup (only for submenu headers) -->
                            <Popup x:Name="PART_Popup" HorizontalOffset="0" VerticalOffset="0"
                                   AllowsTransparency="True" Placement="Right"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="#F51F242E" BorderBrush="#3AFFFFFF"
                                        BorderThickness="1" CornerRadius="8" Padding="4" Margin="6,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#FF000000"/>
                                    </Border.Effect>
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#F51F242E"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="#3AFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent" AllowDrop="True">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Sort by">
                    <MenuItem x:Name="SortNameItem" Header="Name" IsCheckable="True"
                              IsChecked="True" Click="SortName_Click"/>
                    <MenuItem x:Name="SortTypeItem" Header="Type" IsCheckable="True"
                              Click="SortType_Click"/>
                    <MenuItem x:Name="SortDateItem" Header="Date added" IsCheckable="True"
                              Click="SortDate_Click"/>
                </MenuItem>
                <MenuItem Header="View">
                    <MenuItem x:Name="ViewListItem" Header="List" IsCheckable="True"
                              IsChecked="True" Click="ViewList_Click"/>
                    <MenuItem x:Name="ViewIconsItem" Header="Icons" IsCheckable="True"
                              Click="ViewIcons_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Dock to Left Edge" Click="DockLeft_Click"/>
                <MenuItem Header="Dock to Top Edge" Click="DockTop_Click"/>
                <MenuItem Header="Dock to Right Edge" Click="DockRight_Click"/>
                <MenuItem Header="Free Position (drag anywhere)" Click="DockFree_Click"/>
                <Separator/>
                <MenuItem Header="Clear All" Click="ClearAll_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Row 0 = shelf panel, Row 1 = grab handle strip (used when docked to the top edge).
             Column 0 = shelf panel, Column 1 = grab handle (used when docked to a side edge).
             The grid is re-arranged at runtime in ApplyLayout() depending on the dock edge. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColShelf" Width="320"/>
            <ColumnDefinition x:Name="ColHandle" Width="14"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="RowShelf" Height="*"/>
            <RowDefinition x:Name="RowHandle" Height="0"/>
        </Grid.RowDefinitions>

        <!-- ============================== SHELF PANEL ============================== -->
        <Border x:Name="ShelfBorder" Grid.Row="0" Grid.Column="0" Margin="12,16,6,16"
                Background="{DynamicResource ShelfBrush}"
                CornerRadius="14"
                BorderBrush="{DynamicResource CardSeparatorBrush}"
                BorderThickness="1"
                AllowDrop="True">

            <Grid Margin="12,12,12,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Unified bar: collapse / pin / settings | Sort / View.
                     Dragging anywhere on the bar moves the shelf. -->
                <Grid x:Name="HeaderBar" Grid.Row="0" Margin="0,0,0,8"
                      Background="Transparent" MouseLeftButtonDown="HeaderBar_MouseLeftButtonDown">
                    <Border CornerRadius="8" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                            BorderThickness="1" Padding="3,3,0,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SortButton" Content="Sort ▾"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,4"
                                        Click="SortButton_Click"/>
                                <Button x:Name="ViewButton" Content="View ▾"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="4,0,0,0"
                                        Click="ViewButton_Click"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="CollapseButton" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="6,0,0,0"
                                        ToolTip="Collapse shelf" Click="Collapse_Click"/>
                                <Button x:Name="PinButton" Content="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="4,0,0,0"
                                        ToolTip="Always open" Click="Pin_Click"/>
                                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                        Style="{StaticResource GhostButtonStyle}" Padding="8,4" Margin="4,0,0,0"
                                        ToolTip="Settings" Click="OpenSettings_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Card list -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="ItemList" AllowDrop="True"
                             ItemsSource="{Binding ItemsView}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkScrollBar}"/>
                        </ListBox.Resources>
                    </ListBox>

                    <!-- Empty-state hint -->
                    <Border x:Name="EmptyState" CornerRadius="10"
                            BorderBrush="{DynamicResource CardSeparatorBrush}" BorderThickness="1.5"
                            Margin="2"
                            Background="Transparent" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Drop files, folders, links or text"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11.5" Margin="0,8,0,0"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Drag cards out to send them"
                                       Foreground="{DynamicResource SubtleTextBrush}" FontSize="10.5" Margin="0,4,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Footer hint + Clear All -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Button x:Name="ClearAllButton" Content="Clear All"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource GhostButtonStyle}" Margin="0,0,30,0"
                            Click="ClearAll_Click"/>
                </Grid>

                <!-- Easy-to-grab corner resize handle -->
                <Thumb x:Name="CornerResize" Style="{StaticResource CornerResizeThumb}"
                       Tag="BottomRight" Grid.RowSpan="3"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,2,2"
                       DragDelta="ResizeThumb_DragDelta"
                       DragCompleted="ResizeThumb_DragCompleted"
                       ToolTip="Drag to resize"/>
            </Grid>
        </Border>

        <!-- ============================== GRAB HANDLE ============================== -->
        <Border x:Name="HandleArea" Grid.Row="0" Grid.Column="1" Background="Transparent"
                AllowDrop="True" Cursor="Hand"
                ToolTip="Hover to open the shelf">
            <Border x:Name="Grabber" Width="4" Height="88" CornerRadius="2"
                    Background="{DynamicResource HandleBrush}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            </Border>
        </Border>

        <!-- ============================== CAPSULE PILL ==============================
             Shown instead of the shelf when the free-floating shelf collapses:
             a small draggable pill that expands back to the full shelf on hover. -->
        <Border x:Name="Capsule" Grid.Row="0" Grid.Column="0" Visibility="Collapsed"
                Background="{DynamicResource ShelfBrush}" CornerRadius="18"
                BorderBrush="{DynamicResource CardSeparatorBrush}" BorderThickness="1"
                Width="120" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top"
                AllowDrop="True" Cursor="Hand" ToolTip="Click to open the shelf - drag to move it"
                MouseLeftButtonDown="Capsule_MouseLeftButtonDown"
                MouseMove="Capsule_MouseMove"
                MouseLeftButtonUp="Capsule_MouseLeftButtonUp">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="CapsuleText" Text="Drop zone" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="6,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Hold gesture indicator: a ring that fills clockwise while the shelf is
             held out of its dock / near an edge. Positioned in code to follow the
             cursor and stay on-screen (clamped to the work area). -->
        <Grid x:Name="HoldRing" Width="48" Height="48" Visibility="Collapsed"
              IsHitTestVisible="False" Grid.RowSpan="2" Grid.ColumnSpan="2"
              HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border Width="46" Height="46" CornerRadius="23" Background="#C8101018"
                    BorderBrush="{DynamicResource SubtleTextBrush}" BorderThickness="1"/>
            <Path x:Name="HoldRingArc" Width="46" Height="46"
                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Grid>

        <!-- ============================== RESIZE GRIPS ==============================
             Invisible thumbs on the shelf cell edges; all eight are always active,
             in every dock mode (see SetThumbsAll). -->
        <Grid x:Name="ResizeOverlay" Grid.Row="0" Grid.Column="0"
              Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Thumb x:Name="ResizeLeft" Style="{StaticResource EdgeThumb}" Cursor="SizeWE" Tag="Left"
                   HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb x:Name="ResizeRight" Style="{StaticResource EdgeThumb}" Cursor="SizeWE" Tag="Right"
                   HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb x:Name="ResizeTop" Style="{StaticResource EdgeThumb}" Cursor="SizeNS" Tag="Top"
                   HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="8"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb x:Name="ResizeBottom" Style="{StaticResource EdgeThumb}" Cursor="SizeNS" Tag="Bottom"
                   HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="8"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb x:Name="ResizeTopLeft" Style="{StaticResource EdgeThumb}" Cursor="SizeNWSE" Tag="TopLeft"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Width="16" Height="16"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb x:Name="ResizeTopRight" Style="{StaticResource EdgeThumb}" Cursor="SizeNESW" Tag="TopRight"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="16"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb x:Name="ResizeBottomLeft" Style="{StaticResource EdgeThumb}" Cursor="SizeNESW" Tag="BottomLeft"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="16" Height="16"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb x:Name="ResizeBottomRight" Style="{StaticResource EdgeThumb}" Cursor="SizeNWSE" Tag="BottomRight"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16"
                   DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
        </Grid>

    </Grid>
</Window>